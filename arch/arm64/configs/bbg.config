# Samsung SM7325 Baseband-Guard fragment (optional, dispatch only)
# Applied on top of vendor/a52sxq_kor_single_defconfig when the workflow
# runs with use_bbg=true. Wiring (security/baseband-guard symlink +
# security/Makefile + security/Kconfig) mirrors upstream
# vc-teahouse/Baseband-guard setup.sh.
# This 5.4 tree carries a CONFIG_LSM string AND DEFINE_LSM in
# include/linux/lsm_hooks.h, so BBG's Makefile gate requires baseband_guard
# in CONFIG_LSM — hence the extended string below (upstream setup.sh prints
# the same instruction via show_config_lsm_notice).
# BLOCK_BOOT/BLOCK_RECOVERY stay OFF so kernels/recovery remain flashable
# from the running system.
CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,baseband_guard"
